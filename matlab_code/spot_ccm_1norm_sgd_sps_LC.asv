%% spot_ccm_1norm_sgd_sps_LC.m
% Bilevel convex optimization for identifying switching polynomial vector fields
%   System: x' = [x2; mu*(1-x1^2)*x2 - x1^3]  if |x1|<1
%                  [x2; mu*(1-x1^2)*x2 - x1]  if |x1|>=1

clear; clc; close all;

%% --- Load data ---
load("sps_limit_cycle_data.mat");   % contains: data.y, data.dy, data.mode, mu, hyst
X    = data.y;         % (N x 2)
Xdot = data.dy;        % (N x 2)
N    = size(X, 1);
n    = 2;              % state dimension
Q    = 2;              % # modes

%% --- Parameters ---
nIter  = 15;                        % alternating iterations
d      = 3;                         % degree for dynamics basis (needs cubic)
phi_d  = buildMonomialMatrix(X, d); % (N x P)
P      = size(phi_d, 2);

% Logs
cost_poly_log = zeros(nIter, 1);
mode_error    = zeros(nIter, 1);

%% --- Initialization (random 2000 batch) ---
id_all   = randperm(N);
id       = id_all(1:min(2000, N));
xop      = X(id,:);
dz       = Xdot(id,:);
true_mode= data.mode(id,:);   % integer labels 1/2

% Random init for per-mode polynomial coefficients: dx = [phi*a, phi*b]
a1 = randn(P,1); b1 = randn(P,1);
a2 = randn(P,1); b2 = randn(P,1);

%% --- Main Alternation ---
for iter = 1:nIter
    phi_sub = phi_d(id,:);                 % (|id| x P)
    H1      = [phi_sub*a1, phi_sub*b1];    % predicted velocities for mode 1
    H2      = [phi_sub*a2, phi_sub*b2];    % predicted velocities for mode 2
    dy_tilde= {H1, H2};

    %% Step 2: identify soft mode assignments (moment relaxation)
    prog_mode = spotsosprog;
    [sol_mode, prog_mode, ~, vars_mode] = searchMode_moment(dz, dy_tilde, prog_mode);
    lambda_soft = double(sol_mode.eval(vars_mode.lam));   % (|id| x Q)

    % Tightness check via spectral gap on Mi blocks
    tight_count = 0;
    for i = 1:size(lambda_soft,1)
        Mi_num = double(sol_mode.eval(vars_mode.Mi{i}));
        s = svd( (Mi_num + Mi_num.')/2 );
        if numel(s) > 1 && s(2)/max(s(1),1e-12) < 1e-6
            tight_count = tight_count + 1;
        end
    end
    fprintf('Iter %d: Tight (rank-1) moment matrices: %d / %d\n', iter, tight_count, size(lambda_soft,1));

    [~, mode_op] = max(lambda_soft, [], 2);   % hard labels from soft λ

    % Resolve label permutation by comparing to ground-truth (if available)
    if ~isempty(true_mode)
        mismatch1 = nnz(mode_op ~= true_mode);
        mode_op_swapped = 3 - mode_op;
        mismatch2 = nnz(mode_op_swapped ~= true_mode);
        if mismatch2 < mismatch1
            mode_op    = mode_op_swapped;
            lambda_soft= lambda_soft(:, [2 1]); % keep consistency
        end
        mode_error(iter) = nnz(mode_op ~= true_mode);
    end

    %% Step 3: fit polynomial dynamics per mode (soft λ warm start)
    use_soft_lambda = (iter <= 3);
    if use_soft_lambda
        lambda_used = lambda_soft;
    else
        % Hard one-hots from mode_op
        lambda_used = sparse(1:length(mode_op), mode_op, 1, length(mode_op), Q);
        lambda_used = full(lambda_used);
    end

    prog_poly = spotsosprog;
    [sol_poly, prog_poly, cost_vec, vars_poly] = searchPoly(xop, dz, lambda_used, prog_poly, phi_sub);

    % Update coefficients
    a1 = double(sol_poly.eval(vars_poly.a1));
    b1 = double(sol_poly.eval(vars_poly.b1));
    a2 = double(sol_poly.eval(vars_poly.a2));
    b2 = double(sol_poly.eval(vars_poly.b2));

    % Scaled loss (matches your style)
    cost_poly_log(iter) = double(sol_poly.eval(sum(vars_poly.delta) * 1e3));

    fprintf("Iter %3d | Loss: %.4e | Mode mismatch: %d\n", iter, cost_poly_log(iter), mode_error(iter));
end

%% --- Switching Surface Recovery ---
% For this system, the true switching boundary is |x1|=1 (two vertical lines).
% We still learn a polynomial classifier for consistency with your workflow.
kappa   = 2;      % degree of switching surface (degree-2 fits x1^2 - 1)
eta     = 10;
epsilon = 1e-2;
beta    = 1e-2;

% Signed labels from hard mode prediction
sigma = 2*(mode_op == 1) - 1;

[a_opt, z_val, diagnostics] = searchSwitchingSurface_softmargin(xop, sigma, kappa, eta, epsilon, beta);

%% --- Plot styling ---
set(groot, 'defaultFigureColorMode', 'manual');
set(groot, 'defaultFigureColor', 'w');
set(groot, 'defaultAxesColor', 'w');
set(groot, 'defaultAxesXColor', 'k');
set(groot, 'defaultAxesYColor', 'k');
set(groot, 'defaultAxesZColor', 'k');
set(groot, 'defaultTextColor', 'k');
set(groot, 'defaultTextInterpreter','latex')
set(groot, 'defaultAxesTickLabelInterpreter','latex')
set(groot, 'defaultLegendInterpreter','latex')

%% --- Convergence plots ---
figure(1); clf;
hold on; box on; grid on;
plot(abs(cost_poly_log), '-o', 'LineWidth', 1.5);
plot(1e-10 * ones(nIter,1), 'k--');
xlabel('Iteration'); ylabel('Polynomial ID Loss');
title('Polynomial Identification Convergence'); set(gca, 'YScale', 'log');
ax = gca; ax.GridColor = [0.6 0.6 0.6]; ax.GridAlpha = 0.6;
saveas(gcf, 'fig1_spsLC.png'); exportgraphics(gcf, 'fig1_spsLC.pdf', 'ContentType','vector');

figure(2); clf;
hold on; box on; grid on;
plot(mode_error, '-s', 'LineWidth', 1.5);
plot(zeros(nIter,1), 'k--');
xlabel('Iteration'); ylabel('Mismatch Count');
title('Mode Assignment Error');
saveas(gcf, 'fig2_spsLC.png'); exportgraphics(gcf, 'fig2_spsLC.pdf', 'ContentType','vector');

%% --- Mode scatter + Identified Surface ---
idx_mode1 = (sigma == +1);
idx_mode2 = (sigma == -1);

figure(3); clf; hold on; axis equal; grid on;
h1 = scatter(xop(idx_mode1,1), xop(idx_mode1,2), 20, 'y', 'filled', 'DisplayName', 'Mode 1');
h2 = scatter(xop(idx_mode2,1), xop(idx_mode2,2), 20, [0 0 0.8], 'filled', 'DisplayName', 'Mode 2');
legend([h1 h2], 'Location', 'best');
xlabel('$x_1$'); ylabel('$x_2$');
title('Mode Identification (SPS LC)');

% Evaluate learned surface
[x1g, x2g] = meshgrid(linspace(-3.5,3.5,300), linspace(-3.5,3.5,300));
Xgrid = [x1g(:), x2g(:)];
Phi_grid = buildMonomialMatrix(Xgrid, kappa);
Z = reshape(Phi_grid * a_opt, size(x1g));

figure(4); clf; hold on; axis equal; grid on;
h1 = scatter(xop(idx_mode1,1), xop(idx_mode1,2), 20, 'y', 'filled', 'DisplayName', 'Mode 1');
h2 = scatter(xop(idx_mode2,1), xop(idx_mode2,2), 20, [0 0 0.8], 'filled', 'DisplayName', 'Mode 2');
[~, h3] = contour(x1g, x2g, Z, [0,0], 'k', 'LineWidth', 2); h3.DisplayName = '$f(x)=0$';

% True switching boundary (|x1|=1): plot two vertical lines
plot([1 1], ylim, 'r--', 'LineWidth', 2, 'DisplayName', '$|x_1|=1$');
plot([-1 -1], ylim, 'r--', 'LineWidth', 2, 'HandleVisibility','off');

legend([h1 h2 h3], 'Location', 'best', 'Interpreter', 'latex');
xlabel('$x_1$'); ylabel('$x_2$');
title('Identified vs True Switching Surface (SPS LC)');
exportgraphics(gcf,'SPS_LC_switch_surface.pdf','ContentType','vector');

%% --- Notes ---
% * d=3 captures the cubic term inside the strip.
% * kappa=2 suffices to represent x1^2-1; increase if you want more flexibility.
% * Uses soft-λ for first 3 iterations as a warm start, then hard labels.
